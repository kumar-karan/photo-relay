# Phone bridge configuration.
#
# Copy to config.env and edit, or let `bridge setup` write it for you.
# config.env is gitignored because it holds this machine's key path and the
# phone's address.

# Address of the phone as seen from this machine.
#
#   same Wi-Fi as the Mac   the phone's own 192.168.x.x address
#   different networks      the phone's Tailscale 100.x.y.z address
#
# Whichever you are on, this is the one value you change.
PHONE_SSH_HOST=

# Port Termux's sshd listens on. 8023 rather than 22 so it cannot collide with
# anything, and so it is obvious in a port scan which service it is.
PHONE_SSH_PORT=8023

# Termux's own login name. Not root: Termux has no root, and proot's root is a
# different user space entirely.
PHONE_SSH_USER=termux

# Key used for login. Created by `bridge setup`.
PHONE_SSH_KEY=$HOME/.ssh/id_ed25519

# Seconds to wait before declaring the phone unreachable.
PHONE_SSH_TIMEOUT=6

# Pin a adb device when more than one is attached. Empty means take the first.
PHONE_ADB_SERIAL=