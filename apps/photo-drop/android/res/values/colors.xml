<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Light theme only.
         Page is a tinted neutral rather than pure white so that the white cards
         read as raised surfaces instead of the page dissolving into the card. -->

    <color name="page_bg">#F8F9FA</color>
    <color name="surface">#FFFFFF</color>
    <color name="surface_low">#F1F3F5</color>
    <color name="hero_bg">#EAF5EC</color>
    <color name="stroke">#E2E5E8</color>
    <color name="stroke_soft">#EDF0F2</color>

    <!-- Text. Contrast measured against #FFFFFF. -->
    <color name="text_main">#111315</color>   <!-- 17.0:1 -->
    <color name="text_muted">#494E54</color>  <!--  8.4:1 -->
    <color name="text_faint">#6C737B</color>  <!--  5.2:1 -->

    <!-- Accent: deep forest green, not a neon mint. A light tint green on
         white cannot carry white text, so the fill is dark enough to. -->
    <color name="primary">#167A38</color>        <!-- 5.2:1 with white text -->
    <color name="primary_dark">#0E5224</color>   <!-- pressed -->
    <color name="primary_muted">#EAF5EC</color>
    <color name="on_primary">#FFFFFF</color>

    <!-- Semantic -->
    <color name="success">#167A38</color>
    <color name="success_bg">#E6F4EA</color>
    <color name="success_edge">#B7DFC4</color>
    <color name="warning">#B26A00</color>
    <color name="warning_bg">#FDF2E3</color>
    <color name="warning_edge">#EFD3A6</color>
    <color name="danger">#B3261E</color>
    <color name="danger_bg">#FCEDEC</color>
    <color name="danger_edge">#F2C0BC</color>
    <color name="neutral_bg">#EEF0F2</color>
    <color name="neutral_edge">#DBDFE3</color>

    <!-- Press -->
    <color name="surface_press">#E9ECEF</color>
    <color name="row_press">#F1F3F5</color>
    <color name="track_bg">#E6E9EC</color>
    <color name="mono_text">#3D4348</color>
</resources>