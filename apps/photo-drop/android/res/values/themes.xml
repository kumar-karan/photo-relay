<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Light theme only. Parent is the Material LIGHT theme so the framework
         never hands us dark default widget colours. -->
    <style name="AppTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/primary</item>
        <item name="android:colorAccent">@color/primary</item>
        <item name="android:windowBackground">@color/page_bg</item>
        <item name="android:statusBarColor">@color/page_bg</item>
        <item name="android:navigationBarColor">@color/page_bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:textColorPrimary">@color/text_main</item>
        <item name="android:textColorSecondary">@color/text_muted</item>
    </style>
</resources>