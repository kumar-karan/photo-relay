<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_bg"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:id="@+id/root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="24dp"
        android:paddingBottom="32dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="-0.01"
                    android:text="Photo Drop"
                    android:textColor="@color/text_main"
                    android:textSize="24sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tvSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Photos go straight to this phone"
                    android:textColor="@color/text_faint"
                    android:textSize="13sp"/>
            </LinearLayout>

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:background="@drawable/pill_neutral"
                android:paddingLeft="10dp"
                android:paddingTop="6dp"
                android:paddingRight="10dp"
                android:paddingBottom="6dp"
                android:text="READY"
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- Hero: the share link. This is why the app exists. -->
        <LinearLayout
            android:id="@+id/cardLink"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/card_hero"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.08"
                android:text="SEND TO YOUR FRIEND"
                android:textColor="@color/primary"
                android:textSize="10sp"
                android:textStyle="bold"/>

            <!-- Domain forward, so the anchor is readable at a glance -->
            <TextView
                android:id="@+id/tvDropDomain"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="Server not started"
                android:textColor="@color/text_main"
                android:textSize="17sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvDropUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="middle"
                android:fontFamily="monospace"
                android:singleLine="true"
                android:text="--"
                android:textColor="@color/mono_text"
                android:textSize="12sp"/>

            <TextView
                android:id="@+id/tvDropHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="2dp"
                android:text="The link is the password. Anyone who has it can upload."
                android:textColor="@color/text_muted"
                android:textSize="12sp"/>

            <Button
                android:id="@+id/btnCopy"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/btn_primary"
                android:text="Copy link to send"
                android:textAllCaps="false"
                android:textColor="@color/on_primary"
                android:textSize="15sp"
                android:textStyle="bold"/>

            <!-- Secondary path to the same link. Hidden by default: copying is
                 the normal case, so the code should be available rather than
                 permanently on screen. -->
            <TextView
                android:id="@+id/btnQrToggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="6dp"
                android:background="@drawable/btn_text_only"
                android:paddingLeft="12dp"
                android:paddingTop="8dp"
                android:paddingRight="12dp"
                android:paddingBottom="8dp"
                android:text="Show QR code"
                android:textColor="@color/primary"
                android:textSize="13sp"
                android:textStyle="bold"/>

            <LinearLayout
                android:id="@+id/qrBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:visibility="gone">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="14dp"
                    android:background="@color/stroke"/>

                <ImageView
                    android:id="@+id/imgQr"
                    android:layout_width="148dp"
                    android:layout_height="148dp"
                    android:background="@color/surface"
                    android:contentDescription="QR code for the upload link"
                    android:padding="8dp"
                    android:scaleType="fitCenter"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:text="Scan to open the upload page"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Server control -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnStart"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/btn_primary"
                android:text="Start server"
                android:textAllCaps="false"
                android:textColor="@color/on_primary"
                android:textSize="15sp"
                android:textStyle="bold"/>

            <Button
                android:id="@+id/btnStop"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginLeft="10dp"
                android:layout_weight="1"
                android:background="@drawable/btn_tonal"
                android:text="Stop"
                android:textAllCaps="false"
                android:textColor="@color/text_muted"
                android:textSize="15sp"/>
        </LinearLayout>

        <!-- Storage -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="8dp"
            android:letterSpacing="0.08"
            android:text="PHONE STORAGE"
            android:textColor="@color/text_faint"
            android:textSize="10sp"
            android:textStyle="bold"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="true"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvFree"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="-- free"
                    android:textColor="@color/text_main"
                    android:textSize="16sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/btnRefresh"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/btn_text_only"
                    android:paddingLeft="10dp"
                    android:paddingTop="4dp"
                    android:paddingRight="10dp"
                    android:paddingBottom="4dp"
                    android:text="Refresh"
                    android:textColor="@color/primary"
                    android:textSize="13sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <dev.photodrop.app.StorageBarView
                android:id="@+id/storageBar"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="12dp"/>

            <TextView
                android:id="@+id/tvCapacity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:lineSpacingExtra="2dp"
                android:text="Uploads pause at the reserve so the phone never fills."
                android:textColor="@color/text_muted"
                android:textSize="12sp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="14dp"
                android:background="@color/stroke_soft"/>

            <TextView
                android:id="@+id/tvUploads"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No uploads yet"
                android:textColor="@color/text_main"
                android:textSize="14sp"/>

            <TextView
                android:id="@+id/tvScan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Media scan: open the report to see which method works"
                android:textColor="@color/text_faint"
                android:textSize="12sp"/>
        </LinearLayout>

        <!-- Navigation rows -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="8dp"
            android:letterSpacing="0.08"
            android:text="OPEN"
            android:textColor="@color/text_faint"
            android:textSize="10sp"
            android:textStyle="bold"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card"
            android:orientation="vertical"
            android:paddingLeft="8dp"
            android:paddingTop="4dp"
            android:paddingRight="8dp"
            android:paddingBottom="4dp">

            <Button
                android:id="@+id/btnUpload"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/btn_text_only"
                android:drawableEnd="@drawable/chevron"
                android:drawablePadding="10dp"
                android:gravity="center_vertical"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:text="Upload page"
                android:textAllCaps="false"
                android:textColor="@color/text_main"
                android:textSize="14sp"/>

            <Button
                android:id="@+id/btnOwner"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/btn_text_only"
                android:drawableEnd="@drawable/chevron"
                android:drawablePadding="10dp"
                android:gravity="center_vertical"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:text="Owner dashboard"
                android:textAllCaps="false"
                android:textColor="@color/text_main"
                android:textSize="14sp"/>

            <Button
                android:id="@+id/btnScan"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/btn_text_only"
                android:drawableEnd="@drawable/chevron"
                android:drawablePadding="10dp"
                android:gravity="center_vertical"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:text="Media scan report"
                android:textAllCaps="false"
                android:textColor="@color/text_main"
                android:textSize="14sp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tvFooter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:lineSpacingExtra="3dp"
            android:textColor="@color/text_faint"
            android:textSize="11sp"/>
    </LinearLayout>
</ScrollView>