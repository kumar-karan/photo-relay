{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Photo Relay",
  "version": "0.1.0",
  "identifier": "com.kumarkaran.photorelay",
  "build": { "beforeDevCommand": "npm run dev", "devUrl": "http://localhost:1420", "beforeBuildCommand": "npm run build", "frontendDist": "../dist" },
  "app": { "windows": [{ "title": "Photo Relay", "width": 1180, "height": 820, "minWidth": 850, "minHeight": 650, "resizable": true }], "security": { "csp": null } },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns"],
    "macOS": { "minimumSystemVersion": "12.0" }
  }
}
